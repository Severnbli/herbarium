# Herbarium configuration. Copy to `.env` for local development; never commit real values.
# The app validates everything at startup and refuses to run with an invalid configuration.

# Public origin of the app, scheme + host (+ port), no path.
# Required in production and must be https:// (plain http:// is allowed only for localhost).
# Defaults to http://localhost:5173 in development.
ORIGIN=

# Directory holding the encrypted database and media. Required in production.
# Defaults to ./data in development.
DATA_DIR=

# Master key: exactly 32 random bytes, base64 or hex. Generate one with:
#   openssl rand -base64 32
# Set exactly one of the two. In Docker, prefer MASTER_KEY_FILE pointing at a Docker secret.
# IF THE KEY IS LOST, ALL DATA IS UNRECOVERABLE. Store a copy somewhere safe, away from the data volume.
MASTER_KEY=
MASTER_KEY_FILE=
# Set only during rotation to the path of the previous key secret.
MASTER_KEY_PREVIOUS_FILE=

# Upload limits accept byte counts or whole KiB, MiB or GiB values (e.g. 1GiB or "512 MiB").
# Defaults: 128 MiB per file, 129 MiB per request. Leave room for multipart form overhead.
# For node build outside Docker, set BODY_SIZE_LIMIT at or above the request limit
# using adapter-node syntax, e.g. BODY_SIZE_LIMIT=1025M.
MAX_FILE_BYTES=
MAX_REQUEST_BYTES=

# Behind a reverse proxy only: where adapter-node finds the real client address, so login rate
# limiting works per client. Never set these without a proxy in front.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1


# Optional authenticated reminder email. Leave all SMTP settings blank to disable delivery.
# SMTP_HOST must match the relay's TLS certificate. Defaults to STARTTLS on port 587.
# Set SMTP_TLS=implicit for implicit TLS (default port 465).
# SMTP_CREDENTIALS_FILE points to a Docker secret containing JSON with user and pass strings.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_TLS=
SMTP_CREDENTIALS_FILE=
