{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": [
		"src",
		"vite.config.ts",
		"vite.operations.config.ts",
		"prettier.config.js",
		"eslint.config.js",
		"playwright.config.ts",
		"tests"
	]
}
