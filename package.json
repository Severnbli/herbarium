{
	"name": "herbarium",
	"version": "1.1.0",
	"description": "Self-hosted shared calendar and chronicle for a small circle of people",
	"license": "GPL-3.0-only",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --config vite.operations.config.ts",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --project src/service-worker --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"i18n:compile": "paraglide-js compile --project ./project.inlang"
	},
	"dependencies": {
		"@fastify/busboy": "^3.2.6",
		"@js-temporal/polyfill": "^0.5.1",
		"@node-rs/argon2": "^2.2.2",
		"@protomaps/basemaps": "5.7.2",
		"better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.1.1",
		"drizzle-orm": "^0.45.4",
		"maplibre-gl": "^6.19.0",
		"markdown-it": "^15.0.3",
		"nodemailer": "^10.6.0",
		"otpauth": "^9.6.0",
		"pmtiles": "^4.5.0",
		"rrule": "^2.8.1",
		"sanitize-html": "^2.18.2",
		"sharp": "^0.35.5",
		"uqr": "^0.1.3",
		"yauzl": "^3.4.0",
		"yazl": "^3.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@inlang/plugin-message-format": "^4.6.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.2",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"picomatch": "file:vendor/picomatch",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"overrides": {
		"picomatch": "$picomatch",
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		}
	},
	"allowScripts": {
		"esbuild": false,
		"better-sqlite3-multiple-ciphers": false
	}
}
